{
  "schemaVersion": 1,
  "integrityMode": "calibrated",
  "testCommand": "node --test test/action-runtime-security.test.ts",
  "strict": true,
  "minVerified": 1,
  "maintainer": {
    "reviewMode": "automated",
    "requireHumanAttestation": false,
    "requireLinkedIssue": true,
    "requireAiDisclosure": true,
    "maxChangedFiles": 25,
    "maxChangedLines": 1000,
    "requireTestChange": true,
    "testPathPatterns": [
      "test/**",
      "tests/**",
      "__tests__/**",
      "**/*.test.*",
      "**/*.spec.*"
    ],
    "automatedReview": {
      "setupCommand": "npm ci --ignore-scripts",
      "commands": [
        "node --test test/action-runtime-security.test.ts"
      ],
      "timeoutSeconds": 300
    },
    "differentialTest": {
      "command": "node --test test/action-runtime-security.test.ts",
      "setupCommand": "npm ci --ignore-scripts",
      "timeoutSeconds": 300,
      "overlayChangedTests": true
    }
  }
}

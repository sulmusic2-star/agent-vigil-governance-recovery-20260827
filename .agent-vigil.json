{
  "schemaVersion": 1,
  "integrityMode": "calibrated",
  "testCommand": "node --test --test-concurrency=1 test-hosted/*.test.ts",
  "strict": true,
  "minVerified": 1,
  "maintainer": {
    "reviewMode": "automated",
    "requireHumanAttestation": false,
    "requireLinkedIssue": true,
    "requireAiDisclosure": true,
    "maxChangedFiles": 15,
    "maxChangedLines": 450,
    "requireTestChange": true,
    "testPathPatterns": [
      "test-hosted/**"
    ],
    "automatedReview": {
      "setupCommand": "npm ci --ignore-scripts",
      "commands": [
        "node --test --test-concurrency=1 test-hosted/*.test.ts"
      ],
      "timeoutSeconds": 300
    },
    "differentialTest": {
      "command": "node --test --test-concurrency=1 test-hosted/*.test.ts",
      "setupCommand": "npm ci --ignore-scripts",
      "timeoutSeconds": 300,
      "overlayChangedTests": true
    }
  }
}
